# Copy to .env and fill in. .env is gitignored — DISCORD_TOKEN is a real secret
# that lets anyone act as your bot.

# ---- Discord ------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
#   → your app → Bot → Reset Token
DISCORD_TOKEN=

# Right-click your server icon → Copy Server ID.
# (Requires Settings → Advanced → Developer Mode.)
DISCORD_GUILD_ID=

# Right-click the channel alerts should post in → Copy Channel ID.
DISCORD_CHANNEL_ID=

# ---- Sleeper ------------------------------------------------------------
# The long number in your league's web URL:
#   https://sleeper.com/leagues/<THIS>/team
# Or run: python scripts/find_league_id.py <your-sleeper-username>
SLEEPER_LEAGUE_ID=

# ---- Behaviour ----------------------------------------------------------
# How often to check Sleeper. 300s is a good balance: fast enough that the
# alert beats the group chat, slow enough to be a rounding error on the API.
POLL_SECONDS=300

# Never announce a transaction older than this, even if the bot has not seen
# it. Stops a Pi that was off overnight from dumping the backlog into chat.
MAX_BACKFILL_HOURS=48

# Failed waiver claims are off by default — on a contested player, every losing
# bid is its own event and it buries the real news. Set to 1 if your league
# likes the schadenfreude.
ALERT_FAILED_WAIVERS=0

# ---- Runtime ------------------------------------------------------------
# Where the SQLite state and player cache live. Leave this unset when running
# on your own machine — it defaults to ./data, and /data would be a permission
# error at the filesystem root. The container sets it to /data on its own.
# DATA_DIR=

LOG_LEVEL=INFO
